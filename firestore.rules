
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isParticipant() {
      return signedIn()
        && request.auth.uid in resource.data.participantIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete:
        if signedIn() && request.auth.uid == userId;
    }

    // Chat lists will be built from messages, not chats/{userId}.
    match /chats/{chatId} {
      allow read, write: if false;
    }

    match /messages/{messageId} {
      allow read: if isParticipant();

      allow create: if signedIn()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.messages is list
        && request.resource.data.messages.size() == 0
        && request.resource.data.updatedAt is int
        && request.resource.data.lastMessage is string;

      allow update: if isParticipant()
        && request.resource.data.participantIds
          == resource.data.participantIds
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['messages', 'updatedAt', 'lastMessage'])
        && request.resource.data.messages is list
        && request.resource.data.updatedAt is int
        && request.resource.data.lastMessage is string;

      allow delete: if false;
    }
  }
}
